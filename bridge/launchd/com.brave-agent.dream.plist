<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  macOS counterpart of systemd/brave-agent-dream.{service,timer}: memory consolidation.
  StartInterval replaces the timer; launchd has no separate timer unit.
-->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.brave-agent.dream</string>
    <key>ProgramArguments</key>
    <array>
        <string>/opt/homebrew/bin/node</string>
        <string>/Users/USERNAME/.local/share/brave-agent/bridge/dream.mjs</string>
    </array>
    <key>WorkingDirectory</key>
    <string>/Users/USERNAME/.local/share/brave-agent/bridge</string>
    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin</string>
        <key>AGENT_HISTORY_DB</key>
        <string>/Users/USERNAME/Library/Application Support/Aside/Default/History</string>
    </dict>
    <key>StartInterval</key>
    <integer>21600</integer>
    <key>RunAtLoad</key>
    <false/>
    <key>StandardOutPath</key>
    <string>/Users/USERNAME/Library/Logs/brave-agent-dream.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/USERNAME/Library/Logs/brave-agent-dream.log</string>
</dict>
</plist>
